{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "test/fixtures/**"
  ]
}
