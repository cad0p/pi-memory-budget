{
  "name": "@cad0p/pi-memory-budget",
  "version": "0.1.0",
  "description": "Memory budgets for pi extensions: added RSS vs vanilla pi on fresh and long sessions, as a CI gate",
  "type": "module",
  "bin": {
    "pi-memory-budget": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "memory",
    "rss",
    "budget",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cad0p/pi-memory-budget.git"
  },
  "homepage": "https://github.com/cad0p/pi-memory-budget#readme",
  "bugs": {
    "url": "https://github.com/cad0p/pi-memory-budget/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "PMB_E2E=1 node --test test/e2e.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "license": "MIT"
}
